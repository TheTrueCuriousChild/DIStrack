# Root .gitignore for DIStrack project

# Backend ignore fallback
backend/node_modules/
backend/.env
backend/.env.*
!backend/.env.example
backend/generated/

# Common root ignores
node_modules/
.env
.env.*
!.env.example
!.env.template

# IDE & AI Tooling
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
.claude/
.windsurf/
.agents/
.gemini/

# Operating System Files
.DS_Store
.DS_Store?
._*
Thumbs.db
Desktop.ini
